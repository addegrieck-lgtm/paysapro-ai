# Paysapro AI — configuration optionnelle.
# L'application fonctionne SANS aucune variable : copiez ce fichier en `.env.local` seulement si besoin.
#
# ⚠️ IMPORTANT : toute variable VITE_* est intégrée dans le code envoyé au navigateur.
# N'y mettez JAMAIS de clé secrète (clé OpenAI, clé Stripe secrète, mot de passe...).
# Les services payants nécessiteront plus tard un petit backend (voir README, « Évolution »).

# Nom affiché de l'application (optionnel)
VITE_APP_NAME=Paysapro AI

# Active le mode démonstration de l'IA par défaut (true/false). Défaut : false (assistant local à règles).
VITE_AI_DEMO_MODE=false
