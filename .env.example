# Paysapro AI — configuration optionnelle.
# L'application fonctionne SANS aucune variable : copiez ce fichier en `.env.local` seulement si besoin.
#
# ⚠️ IMPORTANT : toute variable VITE_* est intégrée dans le code envoyé au navigateur.
# N'y mettez JAMAIS de secret (clé d'API privée, clé Stripe secrète, mot de passe, clé « service_role »…).

# Nom affiché de l'application
VITE_APP_NAME=Paysapro AI

# Mode test bêta : tout le monde a le plan PREMIUM_MAX gratuitement (laisser à true pendant la bêta)
VITE_TEST_MODE=true

# Ouvre directement l'espace de démonstration (données fictives) au démarrage — utile pour un salon
VITE_DEMO_MODE=false

# Assistant IA en mode démonstration par défaut (réponses fictives clairement signalées)
VITE_AI_DEMO_MODE=false

# Adresse qui reçoit les inscriptions bêta / messages de contact via l'application e-mail du visiteur.
# Facultatif. Adresse publique uniquement (elle sera visible dans le code du site).
VITE_CONTACT_EMAIL=
